# Environment variables for RHDH
# Copy this file to .env and fill in your values

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your-organization

# GitHub OAuth (for authentication)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rhdh
POSTGRES_PASSWORD=rhdh_password
POSTGRES_DB=rhdh

# Scaffolder Configuration
SCAFFOLDER_AUTHOR_NAME=RHDH Scaffolder
SCAFFOLDER_AUTHOR_EMAIL=scaffolder@example.com

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Optional: Additional API tokens
# JIRA_TOKEN=
# GITLAB_TOKEN=
# BITBUCKET_TOKEN=
